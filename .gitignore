# 忽略应用所有文件
/*

# 保留 .gitignore 自身
!.gitignore

# 仅保留简体中文翻译包（Localization/CHN）
!/Localization/
/Localization/*
!/Localization/CHN/
!/Localization/CHN/**

# 保留 RTSS 语言包和简体中文皮肤
!/RTSS/
/RTSS/*
!/RTSS/Localization/
/RTSS/Localization/*
!/RTSS/Localization/CHN/
!/RTSS/Localization/CHN/**
!/RTSS/Skins/
/RTSS/Skins/*
!/RTSS/Skins/Default4Chinese.usf

# 保留本地化参考文档（SDK/Doc/Localization reference.md）
!/SDK/
/SDK/*
!/SDK/Doc/
/SDK/Doc/*
!/SDK/Doc/Localization reference.md

# 保留根目录 README.md
!/README.md
